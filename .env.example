########################################
# Sali VPN — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
########################################

# ---------- General ----------
NODE_ENV=development
APP_NAME=Sali VPN
TZ=UTC

# ---------- Database ----------
# PostgreSQL connection string used by Prisma (apps/api)
DATABASE_URL=postgresql://sali:sali_password@localhost:5432/sali_vpn?schema=public
POSTGRES_USER=sali
POSTGRES_PASSWORD=sali_password
POSTGRES_DB=sali_vpn
# Isolated port used by scripts/start-local-stack.js (avoids a system PostgreSQL on 5432)
LOCAL_POSTGRES_PORT=55432

# ---------- API ----------
API_PORT=3000
API_URL=http://localhost:3000
# Long random string used to sign internal JWTs issued after Telegram auth.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma separated list of admin Telegram IDs allowed to call /admin endpoints
ADMIN_TELEGRAM_IDS=123456789
# Comma separated list of allowed CORS origins (Mini App URL, admin dashboard URL)
CORS_ORIGINS=https://your-miniapp-domain.example
# Shared secret used ONLY for service-to-service calls from the Bot to the API
# over the private Docker network (never exposed publicly). Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=replace_with_a_long_random_string

# ---------- Telegram Bot ----------
# Get this from @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Bot username without the @, used to build referral / deep links
TELEGRAM_BOT_USERNAME=SaliVPNOfficialBot
# Set to "webhook" or "polling". Use polling for local dev, webhook in production.
TELEGRAM_MODE=polling
# Required only when TELEGRAM_MODE=webhook — public HTTPS URL of the bot service
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_string
# Public HTTPS URL of the deployed Mini App (registered with @BotFather as the Web App URL)
TELEGRAM_MINIAPP_URL=https://your-miniapp-domain.example
# Public support chat/account URL, for example https://t.me/SaliSupport
SUPPORT_URL=https://t.me/SaliVPNHelpBot
# Token of the separate @SaliVPNHelpBot created via @BotFather
SUPPORT_BOT_TOKEN=replace-with-support-botfather-token
# Telegram username of the support administrator. The administrator must open the bot and send /start once.
SUPPORT_ADMIN_USERNAME=Chernicka1488
# Address shown by the "Почта поддержки" button
SUPPORT_EMAIL=bravvlstas@gmail.com
# Timeout for Bot -> internal API calls
BOT_API_TIMEOUT_MS=8000

# ---------- Trial ----------
TRIAL_DURATION_MINUTES=60

# ---------- Subscription / Pricing ----------
SUBSCRIPTION_PRICE_USD=5
SUBSCRIPTION_ORIGINAL_PRICE_USD=8
SUBSCRIPTION_DURATION_DAYS=30
MAX_DEVICES_PER_PLAN=3

# ---------- Payments ----------
# Which payment provider adapter to use: manual, telegram_stars, paddle, crypto.
PAYMENT_PROVIDER=manual
# Paddle Billing (cards). A single price ID is enough for the current plan;
# per-plan overrides may use PADDLE_PRICE_ID_<plan UUID>.
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
# Public Paddle.js token: test_... for sandbox, live_... for production.
VITE_PADDLE_CLIENT_TOKEN=
# Optional checkout page override. For Android emulator testing, use localhost
# together with `adb reverse tcp:5173 tcp:5173`.
PADDLE_CHECKOUT_URL=http://localhost:5173/
GOOGLE_PLAY_PACKAGE_NAME=app.sali.vpn
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=sali_pro_monthly
# Base64 of the Play Console service-account JSON. Server only; never put it in APK.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
EXPO_PUBLIC_GOOGLE_PLAY_PRODUCT_ID=sali_pro_monthly
# Usually auto-detected from the key. Optional explicit override:
# PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
# USDT (Jetton) payments to Telegram Wallet / TON Space on TON mainnet.
CRYPTO_WATCHER_ENABLED=false
CRYPTO_TON_RECEIVE_ADDRESS=
# Optional fixed amount for a specific plan:
# CRYPTO_USDT_TON_AMOUNT_<PLAN_UUID>=5
# Without an override, the API charges the plan's final USD amount in USDT.
CRYPTO_INVOICE_TTL_MINUTES=30
CRYPTO_USDT_TON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TONAPI_BASE_URL=https://tonapi.io
TONAPI_API_KEY=
# Required if PAYMENT_PROVIDER=telegram_stars — Telegram Payments provider token from @BotFather
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=

# ---------- VPN (WireGuard) ----------
# Which VPN provider adapter to use. Production and development use WireGuard.
# The mock provider is restricted to NODE_ENV=test and cannot report a fake live connection.
VPN_PROVIDER=wireguard
# Base URL of the WireGuard management agent running on your VPN server(s).
# See docs/vpn-server-setup.md for how to deploy it.
WIREGUARD_API_URL=http://localhost:51821
WIREGUARD_API_KEY=replace_with_a_random_string
WIREGUARD_SERVER_PUBLIC_HOST=vpn1.your-domain.example
WIREGUARD_SERVER_PUBLIC_PORT=51820
WIREGUARD_SERVER_LOCATION=Netherlands

# ---------- Notifications ----------
# Reuses TELEGRAM_BOT_TOKEN to push messages to users (trial expired, payment ok, etc.)

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
