{
  "expo": {
    "name": "Sali VPN",
    "slug": "sali-vpn",
    "scheme": "sali",
    "version": "0.5.7",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/sali-logo.png",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.sali.vpn",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Sali использует сеть для подключения VPN."
      }
    },
    "android": {
      "package": "app.sali.vpn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sali-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#040913"
  }
}
