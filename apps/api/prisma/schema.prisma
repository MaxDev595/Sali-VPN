// Sali VPN — database schema
// Run `npm run prisma:migrate` (apps/api) to apply.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  /// Short human-readable account number shown in the app, bot and support
  /// (e.g. "SL-7K4P-Q2M9" is stored as "7K4PQ2M9").
  publicId      String   @unique
  /// Telegram identity. Null for accounts created by the store app before the
  /// customer opened the bot.
  telegramId    BigInt?  @unique
  /// Store-app installation identity (hashed ANDROID_ID / iOS keychain id).
  appDeviceKey  String?  @unique
  /// Telegram account that "claimed" this app installation via the bot
  /// (t.me/<bot>?start=link_<publicId>). Used for notifications and to show
  /// the customer their devices in the bot.
  linkedTelegramId BigInt?
  linkedAt      DateTime?
  username      String?
  firstName     String?
  lastName      String?
  languageCode  String?
  isBlocked     Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  preferredLanguage String @default("ru")
  notificationsEnabled Boolean @default(true)
  /// Where the customer came from: the /start parameter of their first visit
  /// (t.me/<bot>?start=ad_tiktok → "ad_tiktok", a friend's link → "ref"). For the funnel report.
  source        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vpnAccount     VpnAccount?
  trial          Trial?
  subscriptions  Subscription[]
  payments       Payment[]
  devices        Device[]
  supportTickets SupportTicket[]
  notifications  Notification[]
  announcements  Announcement[]

  // Referral relations: this user was referred by `referredBy`
  referredById  String?
  referredBy    Referral? @relation("ReferredUser")

  // Referrals this user made (as the referrer)
  referralsMade Referral[] @relation("ReferrerUser")

  referralRewards ReferralReward[]

  activationCodesOwned    ActivationCode[] @relation("CodeOwner")
  activationCodesRedeemed ActivationCode[] @relation("CodeRedeemer")

  @@index([telegramId])
  @@index([linkedTelegramId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// VPN
// ---------------------------------------------------------------------------

enum VpnAccountStatus {
  ACTIVE
  DISABLED
  PENDING
  ERROR
}

model VpnServer {
  id           String   @id @default(uuid())
  name         String
  location     String
  publicHost   String
  publicPort   Int
  provider     String   @default("wireguard") // matches VPNProvider implementation key
  isActive     Boolean  @default(true)
  capacity     Int      @default(1000)
  currentLoad  Int      @default(0)
  countryCode  String   @default("NL")
  city         String   @default("Amsterdam")
  premiumOnly  Boolean  @default(false)
  pingMs       Int      @default(35)

  // Sali node agent (infrastructure/vpn-node). Null for legacy/demo rows.
  hostname     String?
  agentUrl     String?
  agentKeyEnc  String?   // encrypted with ENCRYPTION_KEY (legacy rows: JWT_SECRET)
  agentCertPem String?   // self-signed agent certificate, pinned
  wgPublicKey  String?
  awgPublicKey String?
  awgPort      Int?
  awgParams    Json?
  privateDns   Boolean  @default(false) // node runs its own no-log resolver (unbound)
  // Xray VLESS + Reality (Happ and other Xray clients). Null on nodes without Xray.
  xrayPort      Int?
  xrayPublicKey String?
  xrayShortId   String?
  xraySni       String?
  online       Boolean  @default(false)
  lastSeenAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vpnAccounts  VpnAccount[]
}

/// One-time token printed by the bot's /addserver: lets a fresh VPS register itself.
model NodeEnrollToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  name        String
  location    String
  countryCode String
  city        String
  createdBy   String
  expiresAt   DateTime
  usedAt      DateTime?
  serverId    String?
  createdAt   DateTime  @default(now())
}

model VpnAccount {
  id            String            @id @default(uuid())
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  serverId      String
  server        VpnServer         @relation(fields: [serverId], references: [id])

  provider      String            @default("wireguard")
  externalId    String            // id/username of the peer on the VPN provider side
  publicKey     String
  // Private key is generated server-side and only ever sent to the user once
  // (in the connection config); it is stored encrypted at rest.
  privateKeyEncrypted String
  allocatedIp   String
  status        VpnAccountStatus  @default(PENDING)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  devices       Device[]

  @@index([userId])
}

/// Happ (and other Xray clients): one subscription link per Telegram account.
/// The link token works like a password: only its hash is used for lookups, the token
/// itself is kept encrypted so the bot can show the link again.
model HappAccess {
  id          String    @id @default(uuid())
  telegramId  BigInt    @unique
  tokenHash   String    @unique
  tokenEnc    String
  /// VLESS client id on every node.
  uuid        String    @unique
  /// What the nodes were last told (follows the account's access).
  enabled     Boolean   @default(false)
  /// false on the free 24 hours: the UUID is switched on only on the free servers.
  paid        Boolean   @default(true)
  syncedAt    DateTime?
  lastFetchAt DateTime?
  /// First time the «Открыть в Happ» page was opened (funnel report).
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Trials
// ---------------------------------------------------------------------------

enum TrialStatus {
  ACTIVE
  EXPIRED
}

model Trial {
  id         String      @id @default(uuid())
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt  DateTime    @default(now())
  expiresAt  DateTime
  usedSeconds Int        @default(0)
  bonusSeconds Int       @default(0)
  activeSince DateTime?
  status     TrialStatus @default(ACTIVE)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([expiresAt, status])
}

/// Permanent, server-side record that a physical/app installation identity has
/// consumed a trial. Device rows may be deactivated by the user; claims are
/// deliberately never deleted with them.
model TrialDeviceClaim {
  id        String   @id @default(uuid())
  deviceKey String   @unique
  userId    String
  claimedAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plans & Subscriptions
// ---------------------------------------------------------------------------

model Plan {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "pro_monthly"
  name           String            // e.g. "Sali Pro"
  durationDays   Int
  priceUsd       Decimal  @db.Decimal(10, 2)
  originalPriceUsd Decimal? @db.Decimal(10, 2)
  maxDevices     Int      @default(3)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  Subscription[]
  payments       Payment[]
  activationCodes ActivationCode[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PENDING_PAYMENT
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId        String
  plan          Plan               @relation(fields: [planId], references: [id])

  status        SubscriptionStatus @default(PENDING_PAYMENT)
  startedAt     DateTime?
  expiresAt     DateTime?
  autoRenew     Boolean            @default(false)
  canceledAt    DateTime?
  provider       String?
  externalSubscriptionId String? @unique

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  payments      Payment[]

  @@index([userId, status])
  @@index([expiresAt, status])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId           String
  plan             Plan          @relation(fields: [planId], references: [id])

  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])

  provider         String        // "manual" | "telegram_stars" | "stripe" ...
  externalPaymentId String?      // id on the provider's side
  amountUsd        Decimal       @db.Decimal(10, 2)
  discountPercent Int           @default(0)
  currency         String        @default("USD")
  status           PaymentStatus @default(PENDING)
  failureReason    String?
  /// Bot purchases do not activate anything directly: on success an
  /// ActivationCode is issued and sent to the buyer in Telegram.
  deliverAsCode    Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  cryptoInvoice    CryptoInvoice?
  activationCode   ActivationCode?

  @@index([userId, status])
  @@index([externalPaymentId])
}

enum CryptoInvoiceStatus {
  PENDING
  DETECTED
  CONFIRMED
  EXPIRED
}

model CryptoInvoice {
  id             String              @id @default(uuid())
  paymentId      String              @unique
  payment        Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  network        String              @default("TON")
  asset          String              @default("USDT")
  receiveAddress String
  expectedAtomic BigInt
  reference      String              @unique
  decimals       Int                 @default(6)
  status         CryptoInvoiceStatus @default(PENDING)
  txHash         String?             @unique
  expiresAt      DateTime
  detectedAt     DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, expiresAt])
}

model PaymentWebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  externalId String
  eventType  String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  payload    Json

  @@unique([provider, externalId])
}

// ---------------------------------------------------------------------------
// Devices
// ---------------------------------------------------------------------------

enum DevicePlatform {
  IOS
  ANDROID
  WINDOWS
  MACOS
  LINUX
  OTHER
}

model Device {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  vpnAccountId String?
  vpnAccount   VpnAccount?    @relation(fields: [vpnAccountId], references: [id])

  name         String
  deviceKey    String
  platform     DevicePlatform @default(OTHER)
  isActive     Boolean        @default(false)
  lastActiveAt DateTime?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  revokedAt    DateTime?

  @@index([userId])
  @@unique([userId, deviceKey])
}

// ---------------------------------------------------------------------------
// Referrals
// ---------------------------------------------------------------------------

enum ReferralStatus {
  PENDING   // referred user has started the bot but has no reward-triggering action yet
  REWARDED  // referrer has received their reward
}

model Referral {
  id             String         @id @default(uuid())

  referrerId     String
  referrer       User           @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)

  referredUserId String         @unique
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  status         ReferralStatus @default(PENDING)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  rewards        ReferralReward[]

  @@index([referrerId])
}

model ReferralReward {
  id           String   @id @default(uuid())
  referralId   String
  referral     Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  userId       String   // the user who receives the reward (the referrer)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind         String   // "discount_percent"
  amount       Int      // percentage discount, currently 10
  paymentId    String?
  consumedAt   DateTime?
  grantedAt    DateTime @default(now())

  createdAt    DateTime @default(now())

  @@index([userId, kind, consumedAt])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  category  String              // e.g. "vpn_not_connecting", "payment_issue", "other"
  message   String
  status    SupportTicketStatus @default(OPEN)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  TRIAL_EXPIRING_SOON
  TRIAL_EXPIRED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRING_SOON
  SUBSCRIPTION_EXPIRED
  PAYMENT_FAILED
  REFERRAL_REWARD
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  payload   Json?
  sentAt    DateTime?
  createdAt DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Activation codes
// ---------------------------------------------------------------------------
// The only way access reaches the store app: the bot sells (or gives for free)
// a one-time code, the customer types it into the app.

enum ActivationCodeKind {
  PAID   // bought in the bot (Stars / USDT / card)
  FREE   // free tariff, one per Telegram account
  GIFT   // issued by an admin or bought as a gift
  PROMO  // marketing campaigns
}

enum ActivationCodeStatus {
  ISSUED
  REDEEMED
  REVOKED
}

model ActivationCode {
  id            String               @id @default(uuid())
  /// Canonical form without dashes, Crockford base32 (no I, L, O, U).
  code          String               @unique
  kind          ActivationCodeKind
  status        ActivationCodeStatus @default(ISSUED)
  /// Days of access granted. 0 for FREE codes (they unlock the free trial).
  durationDays  Int

  planId        String?
  plan          Plan?                @relation(fields: [planId], references: [id])

  ownerId       String
  owner         User                 @relation("CodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  paymentId     String?              @unique
  payment       Payment?             @relation(fields: [paymentId], references: [id])

  redeemedById  String?
  redeemedBy    User?                @relation("CodeRedeemer", fields: [redeemedById], references: [id])
  redeemedAt    DateTime?

  /// A code must be activated before this date.
  expiresAt     DateTime
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([ownerId, status])
  @@index([redeemedById])
}

// ---------------------------------------------------------------------------
// Announcements: update notes and news from the bot admin panel. Sent to every
// bot user who allows notifications and shown in the apps (GET /announcements).
// ---------------------------------------------------------------------------

enum AnnouncementKind {
  UPDATE
  NEWS
}

model Announcement {
  id          String           @id @default(uuid())
  kind        AnnouncementKind
  /// UPDATE: "android" | "windows" | "all". NEWS: null.
  platform    String?
  /// App version of an UPDATE, e.g. "0.5.4" (the apps compare it with their own).
  version     String?
  /// NEWS headline; UPDATE uses a fixed one.
  title       String?
  /// The admin's own words.
  body        String
  /// Shown in the apps (otherwise only the Telegram broadcast).
  showInApp   Boolean          @default(true)

  recipients  Int              @default(0)
  delivered   Int              @default(0)
  failed      Int              @default(0)
  finishedAt  DateTime?

  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([createdAt])
}
