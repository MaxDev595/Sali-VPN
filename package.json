{
  "name": "sali-vpn",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:bot": "npm run start:dev --workspace=apps/bot",
    "dev:web": "npm run dev --workspace=apps/web",
    "deploy:web": "wrangler deploy",
    "build": "npm run build --workspace=packages/types && npm run build --workspace=apps/api && npm run build --workspace=apps/bot && npm run build --workspace=apps/web",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:studio": "npm run prisma:studio --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
